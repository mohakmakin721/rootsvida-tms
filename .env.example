# ---------------------------------------------------------------------------
# RootsVida TMS — environment template. Copy to `.env` and fill in.
# NEVER commit the real .env (see .gitignore). Secrets via env only.
# ---------------------------------------------------------------------------

# --- Organization ----------------------------------------------------------
# The initial tenant. Not hardcoded in business tables; seeded from here.
RV_ORG_NAME="Rootsvida Experiences Private Limited"
RV_ORG_SLUG="rootsvida"

# --- Database --------------------------------------------------------------
# Local dev via docker-compose uses these. For a managed/cloud Postgres,
# override DATABASE_URL with the provider connection string.
POSTGRES_USER=rootsvida
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=rootsvida_tms
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://rootsvida:change_me_in_local_env@localhost:5432/rootsvida_tms

# pgvector is optional in Phase 1 (semantic search is a later feature).
# Set to 1 only if the target Postgres has the `vector` extension available.
RV_ENABLE_PGVECTOR=0

# --- Object storage (MinIO locally / S3-compatible in prod) ----------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=rootsvida
S3_SECRET_KEY=change_me_in_local_env
S3_BUCKET=rootsvida-source-docs
S3_REGION=ap-south-1

# --- Source data -----------------------------------------------------------
# Immutable input workbooks are read from here (never modified).
# Defaults to the repo root where the originals currently live.
SOURCE_DATA_DIR=.

# --- Domain service --------------------------------------------------------
DOMAIN_SVC_HOST=0.0.0.0
DOMAIN_SVC_PORT=8000
APP_ENV=local
LOG_LEVEL=INFO

# --- Auth (Phase 1: role stub; real auth/RLS in Phase 3 — see DECISIONS.md) -
# The current operator role for the single-user curation tool.
# One of: owner | ops_manager | sales | accounts | readonly
RV_CURRENT_ROLE=owner

# --- LLM (Phase 1: DORMANT. No live calls without explicit approval) --------
# Leave blank in Phase 1. Tier-B price parsing is wired but switched off.
ANTHROPIC_API_KEY=
RV_ENABLE_LLM=0

# --- Web app ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
